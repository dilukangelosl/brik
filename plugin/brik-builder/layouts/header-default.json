{
	"title": "Header — logo, menu, button",
	"category": "header",
	"kind": "section",
	"tree": [
		{
			"type": "section",
			"attrs": {
				"tag": "header",
				"sticky": true,
				"padding": "12px 24px",
				"bg_color": "color-mix(in oklab, var(--background) 85%, transparent)",
				"backdrop_blur": 12,
				"border_width": "0 0 1px 0",
				"border_style": "solid",
				"border_color": "var(--border)"
			},
			"children": [
				{
					"type": "row",
					"attrs": { "columns": "auto 1fr auto", "columns@tablet": "1fr auto", "columns@mobile": "1fr auto", "gap": "24px", "align_items": "center" },
					"children": [
						{ "type": "column", "children": [ { "type": "site_logo", "attrs": { "max_height": "32px" } } ] },
						{
							"type": "column",
							"children": [
								{ "type": "menu", "attrs": { "align": "center", "align@tablet": "right", "link_style": "ghost", "cta": "mobile", "cta_text": "Get started", "breakpoint": "tablet" } }
							]
						},
						{
							"type": "column",
							"attrs": { "hide_on": [ "tablet", "mobile" ] },
							"children": [ { "type": "button", "attrs": { "text": "Get started", "size": "sm", "link": { "url": "#" } } } ]
						}
					]
				}
			]
		}
	]
}
